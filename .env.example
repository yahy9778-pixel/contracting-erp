# ───────── قاعدة البيانات (PostgreSQL) ─────────
# للتطوير المحلي: شغّل  docker compose -f docker-compose.dev.yml up -d
DATABASE_URL="postgresql://erp:erp@localhost:5432/erp"

# ───────── الأمان ─────────
# مفتاح توقيع الجلسات: 32 حرفا على الأقل. أنشئه بالأمر:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# ───────── الوكلاء الأذكياء ─────────
# مفتاح Claude API (اختياري: بدونه يعمل النظام والوكلاء معطلون)
ANTHROPIC_API_KEY=""

# حد اعتماد أوامر الشراء لمدير المشروع (ريال)، وما فوقه يحتاج المالك
# PO_APPROVAL_LIMIT=50000
