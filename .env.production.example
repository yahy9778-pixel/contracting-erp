# انسخ هذا الملف إلى .env على الخادم:  cp .env.production.example .env  ثم  chmod 600 .env
# لا ترفع ملف .env إلى GitHub أبدا (موجود في .gitignore)

# النطاق الذي سيعمل عليه النظام (يجب أن يشير سجل A فيه إلى عنوان الخادم)
DOMAIN="erp.example.com"
# بريد يُستخدم لشهادة HTTPS المجانية من Let's Encrypt
ACME_EMAIL="admin@example.com"

# كلمة مرور قاعدة البيانات: openssl rand -hex 24
POSTGRES_PASSWORD="ضع-قيمة-عشوائية"
# الرابط يُبنى تلقائيا داخل docker-compose من كلمة المرور أعلاه، لا تغيّره إلا إن استخدمت قاعدة خارجية
# DATABASE_URL="postgresql://erp:PASSWORD@db:5432/erp"

# مفتاح الجلسات: openssl rand -base64 48
SESSION_SECRET="ضع-قيمة-عشوائية-طويلة"

# مفتاح Claude API من console.anthropic.com
ANTHROPIC_API_KEY=""

# PO_APPROVAL_LIMIT=50000

# عدد أيام الاحتفاظ بالنسخ الاحتياطية اليومية على الخادم
BACKUP_KEEP_DAYS=14
