// نموذج بيانات المرحلة الأولى (MVP)
// قاعدة البيانات PostgreSQL (للتطوير والتشغيل الفعلي). التغييرات على النموذج تتم عبر prisma migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────── التأسيس ─────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // OWNER | PROJECT_MANAGER | SITE_ENGINEER | CONTRACTS | FINANCE | PLANNING
  role         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  memberships     ProjectMember[]
  reportsCreated  DailyReport[]       @relation("ReportCreator")
  reportsApproved DailyReport[]       @relation("ReportApprover")
  auditLogs       AuditLog[]
  agentActions    AgentAction[]
  irs             InspectionRequest[] @relation("IrCreator")
  ncrs            Ncr[]               @relation("NcrCreator")
  submittals      Submittal[]         @relation("SubmittalCreator")
  rfis            Rfi[]               @relation("RfiCreator")
  prsCreated      PurchaseRequest[]   @relation("PrCreator")
  prsApproved     PurchaseRequest[]   @relation("PrApprover")
  posCreated      PurchaseOrder[]     @relation("PoCreator")
  posApproved     PurchaseOrder[]     @relation("PoApprover")
  receipts        GoodsReceipt[]      @relation("GrnCreator")
}

model ProjectMember {
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

// ───────── الأطراف A..F ─────────

model Party {
  id       String  @id @default(cuid())
  name     String
  // CLIENT | CONSULTANT | SUBCONTRACTOR | SUPPLIER
  type     String
  // تصنيف فرعي مثل A1, B3, D3, E1
  category String?
  phone    String?
  email    String?

  clientProjects     Project[]       @relation("ProjectClient")
  consultantProjects Project[]       @relation("ProjectConsultant")
  quotations         Quotation[]     @relation("QuoteSupplier")
  purchaseOrders     PurchaseOrder[] @relation("PoSupplier")
  subcontracts       Subcontract[]   @relation("SubcontractParty")
  journalLines       JournalLine[]
  payments           Payment[]
  rentedEquipment    Equipment[]
}

// ───────── المشروع ─────────

model Project {
  id                String    @id @default(cuid())
  code              String    @unique
  name              String
  location          String?
  // ACTIVE | ON_HOLD | COMPLETED
  status            String    @default("ACTIVE")
  clientId          String
  consultantId      String?
  contractValue     Float     @default(0)
  startDate         DateTime?
  endDate           DateTime?
  // نسب بالمئة، مثلا 10 تعني 10%
  retentionPct      Float     @default(10)
  advanceAmount     Float     @default(0)
  vatPct            Float     @default(15)
  // عند التفعيل لا تدخل الكمية المستخلص إلا بعد استلام الاستشاري لها (IR معتمد)
  requireInspection Boolean   @default(true)
  createdAt         DateTime  @default(now())

  client           Party                @relation("ProjectClient", fields: [clientId], references: [id])
  consultant       Party?               @relation("ProjectConsultant", fields: [consultantId], references: [id])
  members          ProjectMember[]
  boqItems         BoqItem[]
  dailyReports     DailyReport[]
  ipcs             PaymentCertificate[]
  irs              InspectionRequest[]
  ncrs             Ncr[]
  submittals       Submittal[]
  rfis             Rfi[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  subcontracts     Subcontract[]
  journalLines     JournalLine[]
  expenses         Expense[]
  payments         Payment[]
  guarantees       BankGuarantee[]
  budgets          CostBudget[]
  activities       Activity[]
  warehouses       Warehouse[]
  stockMoves       StockMove[]
  employees        Employee[]
  payrollLines     PayrollLine[]
  equipment        Equipment[]
  equipmentUsages  EquipmentUsage[]
  incidents        SafetyIncident[]
  observations     SafetyObservation[]
  toolboxTalks     ToolboxTalk[]
}

// رموز التكلفة: D1..D11 مقاولو الباطن، E1..E4 الموردون، F1..F3 الأعمال المؤقتة، وغيرها
model CostCode {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  group            String
  boqItems         BoqItem[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  journalLines     JournalLine[]
  expenses         Expense[]
  budgets          CostBudget[]
  stockItems       StockItem[]
  stockMoves       StockMove[]
}

model BoqItem {
  id          String  @id @default(cuid())
  projectId   String
  itemNo      String
  description String
  unit        String
  quantity    Float
  rate        Float
  costCodeId  String?
  sortOrder   Int     @default(0)

  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCode         CostCode?           @relation(fields: [costCodeId], references: [id])
  progress         ProgressEntry[]
  ipcLines         IpcLine[]
  irs              InspectionRequest[]
  ncrs             Ncr[]
  submittals       Submittal[]
  subcontractLines SubcontractLine[]
  activities       Activity[]

  @@unique([projectId, itemNo])
}

// ───────── التنفيذ: التقرير اليومي ─────────

model DailyReport {
  id           String    @id @default(cuid())
  projectId    String
  date         DateTime
  weather      String?
  notes        String?
  issues       String?
  // DRAFT | SUBMITTED | APPROVED | REJECTED
  status       String    @default("DRAFT")
  // MANUAL | AGENT
  source       String    @default("MANUAL")
  rawText      String?
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User             @relation("ReportCreator", fields: [createdById], references: [id])
  approvedBy User?            @relation("ReportApprover", fields: [approvedById], references: [id])
  manpower   ManpowerEntry[]
  equipment  EquipmentEntry[]
  progress   ProgressEntry[]

  @@unique([projectId, date])
}

model ManpowerEntry {
  id       String      @id @default(cuid())
  reportId String
  trade    String
  count    Int
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model EquipmentEntry {
  id       String      @id @default(cuid())
  reportId String
  name     String
  count    Int
  hours    Float?
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ProgressEntry {
  id        String      @id @default(cuid())
  reportId  String
  boqItemId String
  quantity  Float
  location  String?
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  boqItem   BoqItem     @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
}

// ───────── مستخلصات المالك (IPC) ─────────

model PaymentCertificate {
  id              String    @id @default(cuid())
  projectId       String
  number          Int
  periodTo        DateTime
  // DRAFT | SUBMITTED | APPROVED | PAID
  status          String    @default("DRAFT")
  grossCumulative Float
  previousGross   Float
  currentGross    Float
  retention       Float
  advanceRecovery Float
  vat             Float
  netPayable      Float
  approvedAmount  Float?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines   IpcLine[]

  @@unique([projectId, number])
}

model IpcLine {
  id            String             @id @default(cuid())
  ipcId         String
  boqItemId     String
  previousQty   Float
  currentQty    Float
  cumulativeQty Float
  rate          Float
  ipc           PaymentCertificate @relation(fields: [ipcId], references: [id], onDelete: Cascade)
  boqItem       BoqItem            @relation(fields: [boqItemId], references: [id])
}

// ───────── المحرك العام ─────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

// كل ما يفعله وكيل ذكي يسجل هنا
model AgentAction {
  id        String   @id @default(cuid())
  agent     String
  userId    String
  projectId String?
  input     String
  output    String?
  // SUCCESS | ERROR
  status    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// ═══════════ المرحلة الثانية ═══════════

// ───────── الجودة: طلبات الاستلام (IR) وعدم المطابقة (NCR) ─────────

model InspectionRequest {
  id             String    @id @default(cuid())
  projectId      String
  number         Int
  boqItemId      String
  location       String
  quantity       Float
  inspectionDate DateTime
  // OPEN | APPROVED | APPROVED_WITH_COMMENTS | REJECTED
  status         String    @default("OPEN")
  comment        String?
  createdById    String
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem   BoqItem @relation(fields: [boqItemId], references: [id])
  createdBy User    @relation("IrCreator", fields: [createdById], references: [id])

  @@unique([projectId, number])
}

model Ncr {
  id               String    @id @default(cuid())
  projectId        String
  number           Int
  // CONSULTANT | INTERNAL
  source           String
  boqItemId        String?
  location         String?
  description      String
  correctiveAction String?
  dueDate          DateTime?
  // OPEN | CLOSED
  status           String    @default("OPEN")
  closedAt         DateTime?
  createdById      String
  createdAt        DateTime  @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem   BoqItem? @relation(fields: [boqItemId], references: [id])
  createdBy User     @relation("NcrCreator", fields: [createdById], references: [id])

  @@unique([projectId, number])
}

// ───────── المكتب الفني ─────────

model Submittal {
  id          String    @id @default(cuid())
  projectId   String
  number      Int
  revision    Int       @default(0)
  // MATERIAL | SHOP_DRAWING | METHOD_STATEMENT
  type        String
  title       String
  boqItemId   String?
  // DRAFT | SUBMITTED | A | B | C | D
  // A معتمد، B معتمد مع ملاحظات، C يعدل ويعاد، D مرفوض
  status      String    @default("DRAFT")
  submittedAt DateTime?
  dueDate     DateTime?
  respondedAt DateTime?
  comment     String?
  createdById String
  createdAt   DateTime  @default(now())

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem   BoqItem?          @relation(fields: [boqItemId], references: [id])
  createdBy User              @relation("SubmittalCreator", fields: [createdById], references: [id])
  requests  PurchaseRequest[]

  @@unique([projectId, number, revision])
}

model Rfi {
  id          String    @id @default(cuid())
  projectId   String
  number      Int
  subject     String
  question    String
  dueDate     DateTime?
  // OPEN | ANSWERED
  status      String    @default("OPEN")
  answer      String?
  answeredAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("RfiCreator", fields: [createdById], references: [id])

  @@unique([projectId, number])
}

// ───────── المشتريات ─────────

model PurchaseRequest {
  id           String    @id @default(cuid())
  projectId    String
  number       Int
  title        String
  requiredDate DateTime?
  costCodeId   String?
  submittalId  String?
  // DRAFT | SUBMITTED | APPROVED | REJECTED | ORDERED
  status       String    @default("DRAFT")
  createdById  String
  approvedById String?
  createdAt    DateTime  @default(now())

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCode   CostCode?       @relation(fields: [costCodeId], references: [id])
  submittal  Submittal?      @relation(fields: [submittalId], references: [id])
  createdBy  User            @relation("PrCreator", fields: [createdById], references: [id])
  approvedBy User?           @relation("PrApprover", fields: [approvedById], references: [id])
  lines      PrLine[]
  quotations Quotation[]
  orders     PurchaseOrder[]

  @@unique([projectId, number])
}

model PrLine {
  id          String          @id @default(cuid())
  requestId   String
  description String
  unit        String
  quantity    Float
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quoteLines  QuoteLine[]
  poLines     PoLine[]
}

model Quotation {
  id           String          @id @default(cuid())
  requestId    String
  supplierId   String
  deliveryDays Int?
  notes        String?
  createdAt    DateTime        @default(now())
  request      PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplier     Party           @relation("QuoteSupplier", fields: [supplierId], references: [id])
  lines        QuoteLine[]
}

model QuoteLine {
  id          String    @id @default(cuid())
  quotationId String
  prLineId    String
  unitPrice   Float
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  prLine      PrLine    @relation(fields: [prLineId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  projectId    String
  number       Int
  requestId    String
  supplierId   String
  costCodeId   String?
  total        Float
  // PENDING_APPROVAL | ISSUED | PARTIAL | RECEIVED | CANCELLED
  status       String
  createdById  String
  approvedById String?
  createdAt    DateTime @default(now())

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  request    PurchaseRequest @relation(fields: [requestId], references: [id])
  supplier   Party           @relation("PoSupplier", fields: [supplierId], references: [id])
  costCode   CostCode?       @relation(fields: [costCodeId], references: [id])
  createdBy  User            @relation("PoCreator", fields: [createdById], references: [id])
  approvedBy User?           @relation("PoApprover", fields: [approvedById], references: [id])
  lines      PoLine[]
  receipts   GoodsReceipt[]

  @@unique([projectId, number])
}

model PoLine {
  id          String        @id @default(cuid())
  orderId     String
  prLineId    String?
  description String
  unit        String
  quantity    Float
  unitPrice   Float
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  prLine      PrLine?       @relation(fields: [prLineId], references: [id])
  receipts    GrnLine[]
}

model GoodsReceipt {
  id           String        @id @default(cuid())
  orderId      String
  // عند الإدخال لمستودع: تُثبت المواد مخزونا بدل تحميلها على التكلفة مباشرة
  warehouseId  String?
  warehouse    Warehouse?    @relation(fields: [warehouseId], references: [id])
  date         DateTime
  deliveryNote String?
  createdById  String
  createdAt    DateTime      @default(now())
  order        PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("GrnCreator", fields: [createdById], references: [id])
  lines        GrnLine[]
}

model GrnLine {
  id        String       @id @default(cuid())
  receiptId String
  poLineId  String
  quantity  Float
  receipt   GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLine    PoLine       @relation(fields: [poLineId], references: [id], onDelete: Cascade)
}

// ───────── مقاولو الباطن ─────────

model Subcontract {
  id              String   @id @default(cuid())
  projectId       String
  number          Int
  subcontractorId String
  scope           String
  retentionPct    Float    @default(10)
  vatPct          Float    @default(15)
  // ACTIVE | CLOSED
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())

  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor Party                    @relation("SubcontractParty", fields: [subcontractorId], references: [id])
  lines         SubcontractLine[]
  certificates  SubcontractCertificate[]

  @@unique([projectId, number])
}

model SubcontractLine {
  id            String                @id @default(cuid())
  subcontractId String
  boqItemId     String
  quantity      Float
  rate          Float
  subcontract   Subcontract           @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  boqItem       BoqItem               @relation(fields: [boqItemId], references: [id])
  certLines     SubcontractCertLine[]

  @@unique([subcontractId, boqItemId])
}

model SubcontractCertificate {
  id              String    @id @default(cuid())
  subcontractId   String
  number          Int
  periodTo        DateTime
  // DRAFT | APPROVED | PAID
  status          String    @default("DRAFT")
  grossCumulative Float
  previousGross   Float
  currentGross    Float
  retention       Float
  vat             Float
  netPayable      Float
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  subcontract Subcontract           @relation(fields: [subcontractId], references: [id], onDelete: Cascade)
  lines       SubcontractCertLine[]

  @@unique([subcontractId, number])
}

model SubcontractCertLine {
  id            String                 @id @default(cuid())
  certificateId String
  lineId        String
  previousQty   Float
  currentQty    Float
  cumulativeQty Float
  rate          Float
  certificate   SubcontractCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  line          SubcontractLine        @relation(fields: [lineId], references: [id])
}

// ═══════════ المرحلة الثالثة: المالية والتخطيط ═══════════

// ───────── الحسابات العامة ─────────

// دليل الحسابات
model Account {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  type   String
  // حساب نقدية أو بنك يمكن الصرف والتحصيل منه
  isCash Boolean @default(false)
  active Boolean @default(true)

  lines    JournalLine[]
  expenses Expense[]
  payments Payment[]
}

// قيد يومية. القيود الآلية تحمل sourceKey يمنع ترحيل الحدث مرتين
model JournalEntry {
  id          String   @id @default(cuid())
  number      Int      @unique
  date        DateTime
  description String
  sourceKey   String?  @unique
  // MANUAL | AUTO
  kind        String   @default("AUTO")
  reversedBy  String?
  createdById String?
  createdAt   DateTime @default(now())

  lines JournalLine[]
}

model JournalLine {
  id         String  @id @default(cuid())
  entryId    String
  accountId  String
  debit      Float   @default(0)
  credit     Float   @default(0)
  projectId  String?
  costCodeId String?
  partyId    String?
  memo       String?

  entry    JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account  Account      @relation(fields: [accountId], references: [id])
  project  Project?     @relation(fields: [projectId], references: [id])
  costCode CostCode?    @relation(fields: [costCodeId], references: [id])
  party    Party?       @relation(fields: [partyId], references: [id])

  @@index([accountId])
  @@index([projectId])
}

// مصروفات الموقع والعهد النقدية
model Expense {
  id          String   @id @default(cuid())
  projectId   String
  number      Int
  date        DateTime
  costCodeId  String
  description String
  payee       String?
  amount      Float
  vat         Float    @default(0)
  paidFromId  String
  reference   String?
  createdById String
  createdAt   DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCode CostCode @relation(fields: [costCodeId], references: [id])
  paidFrom Account  @relation(fields: [paidFromId], references: [id])

  @@unique([projectId, number])
}

// سندات الصرف والقبض التي لا تأتي من مستخلص
model Payment {
  id          String   @id @default(cuid())
  number      Int      @unique
  date        DateTime
  // SUPPLIER_PAYMENT | ADVANCE_RECEIPT
  kind        String
  projectId   String
  partyId     String
  accountId   String
  amount      Float
  reference   String?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  party   Party   @relation(fields: [partyId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
}

// خطابات الضمان
model BankGuarantee {
  id         String    @id @default(cuid())
  projectId  String
  // BID | PERFORMANCE | ADVANCE | RETENTION
  type       String
  bank       String
  number     String
  amount     Float
  issueDate  DateTime
  expiryDate DateTime
  // ACTIVE | RELEASED
  status     String    @default("ACTIVE")
  releasedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ───────── ضبط التكاليف ─────────

model CostBudget {
  projectId  String
  costCodeId String
  amount     Float

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCode CostCode @relation(fields: [costCodeId], references: [id])

  @@id([projectId, costCodeId])
}

// ───────── التخطيط: الجدول الزمني ─────────

model Activity {
  id        String   @id @default(cuid())
  projectId String
  code      String
  name      String
  startDate DateTime
  endDate   DateTime
  // الوزن النسبي في المشروع، افتراضيا قيمة البند في BOQ
  weight    Float
  // نشاط مرتبط ببند: إنجازه من التقارير اليومية المعتمدة
  boqItemId String?
  // نشاط غير مرتبط ببند: نسبة إنجاز يدخلها المخطط (0..1)
  manualPct Float?
  sortOrder Int      @default(0)

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItem BoqItem? @relation(fields: [boqItemId], references: [id])

  @@unique([projectId, code])
}

// ═══════════ المرحلة الرابعة ═══════════

// ───────── المخازن ─────────

// المستودع المركزي (بدون مشروع) أو مستودع موقع
model Warehouse {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  projectId String?

  project  Project?       @relation(fields: [projectId], references: [id])
  moves    StockMove[]
  receipts GoodsReceipt[]
}

model StockItem {
  id         String  @id @default(cuid())
  code       String  @unique
  name       String
  unit       String
  costCodeId String?
  // حد إعادة الطلب: تنبيه عند نزول الرصيد الكلي عنه
  minQty     Float   @default(0)

  costCode CostCode?   @relation(fields: [costCodeId], references: [id])
  moves    StockMove[]

  @@unique([name, unit])
}

// كل حركة مخزنية: الكمية والقيمة بإشارة (+ دخول، - خروج). التكلفة بالمتوسط المرجح
model StockMove {
  id          String   @id @default(cuid())
  number      Int
  date        DateTime
  // IN | ISSUE | TRANSFER | ADJUST
  type        String
  warehouseId String
  itemId      String
  quantity    Float
  unitCost    Float
  value       Float
  projectId   String?
  costCodeId  String?
  grnId       String?
  reference   String?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  item      StockItem @relation(fields: [itemId], references: [id])
  project   Project?  @relation(fields: [projectId], references: [id])
  costCode  CostCode? @relation(fields: [costCodeId], references: [id])

  @@index([itemId])
  @@index([number])
}

// ───────── الموارد البشرية والرواتب ─────────

model Employee {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  nationalId  String?
  jobTitle    String
  // STAFF موظف | LABOR عامل
  kind        String    @default("LABOR")
  trade       String?
  basicSalary Float
  allowances  Float     @default(0)
  // المشروع المعيّن عليه، وبدونه: المركز الرئيسي
  projectId   String?
  joinDate    DateTime
  // انتهاء الإقامة أو الهوية
  idExpiry    DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  project      Project?      @relation(fields: [projectId], references: [id])
  payrollLines PayrollLine[]
}

model PayrollRun {
  id          String    @id @default(cuid())
  // YYYY-MM
  month       String    @unique
  // DRAFT | APPROVED | PAID
  status      String    @default("DRAFT")
  approvedAt  DateTime?
  paidAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  lines PayrollLine[]
}

model PayrollLine {
  id            String  @id @default(cuid())
  runId         String
  employeeId    String
  projectId     String?
  daysWorked    Float   @default(30)
  basic         Float
  allowances    Float
  overtimeHours Float   @default(0)
  overtimePay   Float   @default(0)
  deductions    Float   @default(0)
  net           Float

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])
  project  Project?   @relation(fields: [projectId], references: [id])

  @@unique([runId, employeeId])
}

// ───────── المعدات والورشة ─────────

model Equipment {
  id              String  @id @default(cuid())
  code            String  @unique
  name            String
  // رمز التكلفة: E3 معدات، F2 نقل أفقي، F3 نقل رأسي
  costCode        String  @default("E3")
  // OWNED | RENTED
  ownership       String  @default("OWNED")
  supplierId      String?
  // تكلفة الساعة المحمّلة على المشروع
  hourlyRate      Float
  projectId       String?
  // ACTIVE | MAINTENANCE | IDLE
  status          String  @default("ACTIVE")
  meterHours      Float   @default(0)
  serviceInterval Float?
  lastServiceAt   Float   @default(0)

  supplier   Party?           @relation(fields: [supplierId], references: [id])
  project    Project?         @relation(fields: [projectId], references: [id])
  usages     EquipmentUsage[]
  workOrders WorkOrder[]
}

model EquipmentUsage {
  id          String   @id @default(cuid())
  equipmentId String
  projectId   String
  date        DateTime
  hours       Float
  rate        Float
  operator    String?
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id])
}

// أمر عمل الورشة: صيانة وقائية أو إصلاح عطل
model WorkOrder {
  id          String    @id @default(cuid())
  number      Int       @unique
  equipmentId String
  // PREVENTIVE | BREAKDOWN
  kind        String
  description String
  // OPEN | DONE
  status      String    @default("OPEN")
  cost        Float     @default(0)
  paidFrom    String?
  resolution  String?
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  createdById String

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

// ───────── وكلاء الأقسام ─────────

model AgentReport {
  id          String   @id @default(cuid())
  department  String
  projectId   String?
  createdById String
  // JSON بمخرجات الوكيل
  output      String
  createdAt   DateTime @default(now())

  @@index([department, projectId])
}

// ───────── السلامة (HSE) ─────────

model SafetyIncident {
  id               String    @id @default(cuid())
  projectId        String
  number           Int
  date             DateTime
  // NEAR_MISS | FIRST_AID | LOST_TIME | PROPERTY_DAMAGE | ENVIRONMENT
  kind             String
  location         String?
  description      String
  injured          String?
  lostDays         Float     @default(0)
  rootCause        String?
  correctiveAction String?
  // OPEN | CLOSED
  status           String    @default("OPEN")
  closedAt         DateTime?
  createdById      String
  createdAt        DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
}

// ملاحظة سلامة من جولة تفتيش: تُسند لمسؤول بموعد تصحيح
model SafetyObservation {
  id          String    @id @default(cuid())
  projectId   String
  number      Int
  date        DateTime
  category    String
  severity    String
  description String
  assignedTo  String
  dueDate     DateTime
  status      String    @default("OPEN")
  closureNote String?
  closedAt    DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
}

model ToolboxTalk {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime
  topic       String
  attendees   Int
  createdById String
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// محاولات الدخول الفاشلة: لإيقاف التخمين
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
